{
  "manifest_version": 3,
  "name": "Nol-Post",
  "version": "0.1.1",
  "description": "NOL 포스트시즌 Rec 전용 (PostLab 파생)",
  "permissions": ["sidePanel", "storage", "tabs", "alarms", "scripting"],
  "host_permissions": [
    "https://nol.yanolja.com/*",
    "https://*.yanolja.com/*",
    "https://tickets.interpark.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Nol-Post",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://nol.yanolja.com/*", "https://*.yanolja.com/*"],
      "js": ["content-nol.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
